<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2B3639"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="50dp"
    android:paddingBottom="40dp">

    <!-- Top Call Info -->
    <LinearLayout
        android:id="@+id/topInfoLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCallDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00 (Calling)"
            android:textColor="#CCCCCC"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Caller Name"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCallerNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mobile"
            android:textColor="#DDDDDD"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- 6 In-Call Control Buttons Grid -->
    <GridLayout
        android:id="@+id/controlsGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/btnEndCall"
        android:layout_marginBottom="50dp"
        android:alignmentMode="alignMargins"
        android:columnCount="3"
        android:rowCount="2"
        android:useDefaultMargins="true">

        <!-- Mute -->
        <LinearLayout
            android:id="@+id/btnMute"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivMuteIcon"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:background="@drawable/circle_button_bg"
                android:padding="20dp"
                android:src="@android:drawable/stat_notify_call_mute"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Mute"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Keypad -->
        <LinearLayout
            android:id="@+id/btnKeypad"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:background="@drawable/circle_button_bg"
                android:padding="20dp"
                android:src="@android:drawable/ic_dialog_dialer"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Keypad"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Record Button -->
        <LinearLayout
            android:id="@+id/btnRecord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivRecordIcon"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:background="@drawable/circle_button_bg"
                android:padding="20dp"
                android:src="@android:drawable/ic_btn_speak_now"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/tvRecordText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Record"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Hold -->
        <LinearLayout
            android:id="@+id/btnHold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivHoldIcon"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:background="@drawable/circle_button_bg"
                android:padding="20dp"
                android:src="@android:drawable/ic_media_pause"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Hold"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Speaker -->
        <LinearLayout
            android:id="@+id/btnSpeaker"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivSpeakerIcon"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:background="@drawable/circle_button_bg"
                android:padding="20dp"
                android:src="@android:drawable/ic_lock_silent_mode_off"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Speaker"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Bluetooth -->
        <LinearLayout
            android:id="@+id/btnBluetooth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:background="@drawable/circle_button_bg"
                android:padding="20dp"
                android:src="@android:drawable/stat_sys_data_bluetooth"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Bluetooth"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

    </GridLayout>

    <!-- Red Circular End Call Button -->
    <ImageView
        android:id="@+id/btnEndCall"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:background="@drawable/circle_red_bg"
        android:padding="20dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:tint="#FFFFFF" />

</RelativeLayout>
